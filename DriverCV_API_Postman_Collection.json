              "raw": "{\n  \"jobTitle\": \"Direct Private Delivery Offer\",\n  \"vehicleRequired\": \"Class B Van\",\n  \"employmentType\": \"Contract\",\n  \"workingHours\": \"Flexible 6 Hours\",\n  \"salaryType\": \"monthly\",\n  \"salaryAmount\": \"34000 SEK\",\n  \"location\": \"Stockholm\",\n  \"jobDescription\": \"Direct private invitation sent specifically for your profile qualifications.\",\n  \"requirements\": \"Class B license\",\n  \"requiresTKT\": false,\n  \"hrId\": 1,\n  \"isDirectOffer\": true,\n  \"assignedDriverId\": 1\n}"
