            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullname\": \"Mohammad Easin\",\n  \"email\": \"easin.driver@example.com\",\n  \"phonenumber\": \"+46 70 123 45 67\",\n  \"ProfileImage\": \"https://images.unsplash.com/photo-1534528741775-53994a69daeb\",\n  \"password\": \"DriverPass123!\",\n  \"workingHours\": \"8 Hours\",\n  \"licenseCategories\": [\"Class B\", \"Class C (Truck)\"],\n  \"targetMonthlySalary\": 35000,\n  \"regions\": [\"Stockholm\", \"Uppsala\"],\n  \"personalIdentityNumber\": \"19900101-1234\",\n  \"drivingLicenseNumber\": \"SE-12345678\",\n  \"certificates\": \"https://example.com/certificates/c-license.pdf\"\n}"
