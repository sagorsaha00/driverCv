    {
      "name": "3. Driving Jobs & Direct Offers",
      "item": [
        {
          "name": "Create Public Driving Job",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jobTitle\": \"Heavy Truck Long Haul Driver\",\n  \"vehicleRequired\": \"Class C (Truck)\",\n  \"employmentType\": \"Full-time\",\n  \"workingHours\": \"8 Hours / Day\",\n  \"salaryType\": \"monthly\",\n  \"salaryAmount\": \"36000 SEK\",\n  \"location\": \"Stockholm\",\n  \"jobDescription\": \"We are looking for an experienced commercial truck driver for intercity transport.\",\n  \"requirements\": \"Clean driving record, YKB/CPC certification\",\n  \"requiresTKT\": false,\n  \"hrId\": 1,\n  \"isDirectOffer\": false,\n  \"assignedDriverId\": null\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/driverJob/createDriverJob",
              "host": ["{{baseUrl}}"],
              "path": ["api", "driverJob", "createDriverJob"]
            }
          }
        },
